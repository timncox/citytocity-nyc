---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HowWeHelp from "../components/HowWeHelp.astro";
import Programs from "../components/Programs.astro";
import Nova from "../components/Nova.astro";
import Belief from "../components/Belief.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import Memorial from "../components/Memorial.astro";
import Footer from "../components/Footer.astro";
import { site, getPage } from "../site";

const home = getPage("/");
---
<Base title={home?.title ?? site.site.name} description={site.site.description} pageSlug="/">
  <Hero />
  <HowWeHelp />
  <Programs />
  <Nova />
  <Belief />
  <WhoWeAre />
  <Memorial />
  <Footer />
</Base>
