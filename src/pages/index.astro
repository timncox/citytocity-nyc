---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Pathways from "../components/Pathways.astro";
import Nova from "../components/Nova.astro";
import Conviction from "../components/Conviction.astro";
import Events from "../components/Events.astro";
import Memorial from "../components/Memorial.astro";
import Footer from "../components/Footer.astro";
import { site, getPage } from "../site";

const home = getPage("/");
---
<Base title={home?.title ?? site.site.name} description={site.site.description} pageSlug="/">
  <Header />
  <Hero />
  <Pathways />
  <Nova />
  <Conviction />
  <Events />
  <Memorial />
  <Footer involved={true} />
</Base>
