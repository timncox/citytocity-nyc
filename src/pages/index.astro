---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Statement from "../components/Statement.astro";
import Pathways from "../components/Pathways.astro";
import Quote from "../components/Quote.astro";
import Nova from "../components/Nova.astro";
import Gallery from "../components/Gallery.astro";
import Memorial from "../components/Memorial.astro";
import Footer from "../components/Footer.astro";
import { site, getPage } from "../site";

const home = getPage("/");
---
<Base title={home?.title ?? site.site.name} description={site.site.description} pageSlug="/">
  <Header />
  <Hero />
  <Statement />
  <Pathways />
  <Quote />
  <Nova />
  <Gallery />
  <Memorial />
  <Footer />
</Base>
