---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Base title="Not found" pageSlug="/404">
  <Header solid={true} />
  <div class="subpage">
    <div class="wrap">
      <article class="prose">
        <span class="eyebrow kicker">404</span>
        <h1>This page wandered off.</h1>
        <p class="lead">The address you tried doesn&rsquo;t lead anywhere on this site.</p>
        <p><a href="/">← Return home</a> — or explore <a href="/programs">our programs</a> and <a href="/nova-omnia">Nova Omnia</a>.</p>
      </article>
    </div>
  </div>
  <Footer />
</Base>
