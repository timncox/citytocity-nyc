---
import "../styles/global.css";
import { site } from "../site";

interface Props {
  title: string;
  description?: string;
  pageSlug: string;
}

const { title, description, pageSlug } = Astro.props;
const pageDescription = description ?? site.site.description;
const fullTitle = pageSlug === "/" ? `${site.site.name} — ${site.site.tagline}` : `${title} · ${site.site.name}`;
const canonicalUrl = site.site.url ? new URL(pageSlug, site.site.url).toString() : pageSlug;
const ogImagePath = "/media/photo-1.jpg";
const ogImage = site.site.url ? new URL(ogImagePath, site.site.url).toString() : ogImagePath;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": site.schema?.type ?? "Organization",
  name: site.site.name,
  description: site.site.description,
  ...(site.site.url ? { url: site.site.url } : {}),
  ...(site.schema?.extra ?? {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => { try {
        const s = localStorage.getItem("ctc-theme");
        const t = s || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "night" : "day");
        document.documentElement.dataset.theme = t;
      } catch (e) {} })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <meta name="theme-color" content="#E7E4DD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15140F" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.site.name} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/json" href="/api/site.json" title={`${site.site.name} content (machine-readable)`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site guide" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/media/favicon.png" />
    <link rel="apple-touch-icon" href="/media/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <slot />
    </main>
    <script is:inline>
      (() => {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
        const run = () => document.querySelectorAll(".rv").forEach((el) => io.observe(el));
        if (document.readyState !== "loading") run();
        else document.addEventListener("DOMContentLoaded", run);
        const tog = document.querySelector(".toggle");
        if (tog) {
          tog.setAttribute("aria-pressed", document.documentElement.dataset.theme === "night");
          tog.addEventListener("click", () => {
            const next = document.documentElement.dataset.theme === "night" ? "day" : "night";
            document.documentElement.dataset.theme = next;
            try { localStorage.setItem("ctc-theme", next); } catch (e) {}
            tog.setAttribute("aria-pressed", next === "night");
          });
        }
        window.addEventListener("load", () => {
          document.querySelectorAll(".hero .rv").forEach((el, i) => {
            el.style.transitionDelay = i * 0.09 + "s";
            el.classList.add("in");
          });
        });
      })();
    </script>
  </body>
</html>
