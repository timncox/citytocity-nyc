---
import { site, emph } from "../site";
const c = site.home.conviction;
---
<section class="conviction">
  <div class="wrap">
    <div class="rule-orn rv">✦</div>
    <span class="eyebrow center rv">{c.eyebrow}</span>
    <p class="q rv" set:html={emph(c.quote)} />
    <div class="src rv">{c.source}</div>
  </div>
</section>
