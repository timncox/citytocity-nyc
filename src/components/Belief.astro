---
import { site, emph } from "../site";
const b = site.home.belief;
const rows = site.home.rows;
---
<section class="belief" id="give">
  <div class="wrap">
    <h2 class="rv" set:html={emph(b.heading)} />
  </div>
</section>
<section class="rows">
  <div class="wrap">
    {rows.map((r) => (
      <div class="row rv">
        <div class="ph"><img src={r.image} alt={r.title} loading="lazy" /></div>
        <div>
          <h3>{r.title}</h3>
          <p set:html={emph(r.body)} />
          <a class="btn" href={r.cta.href}>{r.cta.label} <span class="a">→</span></a>
        </div>
      </div>
    ))}
  </div>
</section>
