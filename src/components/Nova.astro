---
import { site, emph } from "../site";
const n = site.home.nova;
---
<section class="nova" id="nova">
  <div class="wrap">
    <div class="nova-grid">
      <figure class="nova-fig rv"><img src={n.image} alt="A gathering at Nova Omnia" loading="lazy" /></figure>
      <div>
        <span class="lab rv">{n.index} — {n.kicker}</span>
        <h2 class="disp rv" set:html={emph(n.title)} />
        <p class="rv">{n.body}</p>
        <div class="addr lab rv">{n.address}</div>
        <a class="btn-line rv" href={n.cta.href}>{n.cta.label} →</a>
      </div>
    </div>
  </div>
</section>
<div class="divider"></div>
