---
import { site } from "../site";
const h = site.home.hero;
const cls = ["l1", "l2", "l3"];
---
<section class="hero">
  <div class="wrap">
    <h1 class="rv">
      {h.lines.map((line, i) => (
        <span class={`l ${cls[i] ?? "l3"}${line.italic ? " it" : ""}`}>{line.text}</span>
      ))}
    </h1>
    <nav class="breadcrumb rv" aria-label="Sections">
      {h.breadcrumb.map((item, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          <a href={item.href}>{item.label}</a>
        </>
      ))}
    </nav>
    <p class="lede rv">{h.lede}</p>
  </div>
</section>
