---
import { site, emph } from "../site";
const h = site.home.hero;
---
<section class="hero">
  <div class="wrap">
    <span class="ey rv">{h.eyebrow}</span>
    <h1 class="rv" set:html={emph(h.headline)} />
    <p class="sub rv">{h.sub}</p>
    <div class="img rv">
      <img src={h.image} alt={h.imageCaption} loading="eager" />
      <span class="cap">{h.imageCaption}</span>
    </div>
  </div>
</section>
