---
import { site, emph } from "../site";
const intro = site.home.pathwaysIntro;
const pathways = site.home.pathways;
---
<section class="pathways sec-pad" id="pathways">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="rv" set:html={emph(intro.heading)} />
      <p class="note rv">{intro.note}</p>
    </div>
    <div class="path-grid">
      {pathways.map((p, i) => (
        <article class="path rv" style={`transition-delay:${i * 0.08}s`}>
          <span class="glyph">{p.glyph}</span>
          <span class="num">{p.num}</span>
          <h3 set:html={emph(p.title)} />
          <p>{p.blurb}</p>
          <ul>
            {p.programs.map((prog) => (
              <li><span class="pname">{prog.name}</span><span class="pdesc">{prog.desc}</span></li>
            ))}
          </ul>
          <a class="go" href={p.cta.href}>{p.cta.label} <span class="arw">→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
