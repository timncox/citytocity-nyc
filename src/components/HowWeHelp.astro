---
import { site, emph } from "../site";
const h = site.home.howWeHelp;
---
<section class="help">
  <div class="wrap help-grid">
    <div class="help-card rv">
      <h2 set:html={emph(h.heading)} />
      <p>{h.body}</p>
      <a class="btn" href={h.cta.href}>{h.cta.label} <span class="a">→</span></a>
    </div>
    <a class="film rv" href={h.video.href} style={`background-image:linear-gradient(115deg,rgba(40,46,52,.5),rgba(10,12,14,.7)),url(${h.video.image})`}>
      <div class="sl"></div>
      <span class="num n1">36</span><span class="num n2">36A</span>
      <div class="lbl">{h.video.label}</div>
      <div class="play"></div>
    </a>
  </div>
</section>
