---
import { site, emph } from "../site";
const g = site.home.give;
const b = site.home.brand;
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <h4 class="disp" set:html={emph(g.cta)} />
      <form class="foot-news" action={`mailto:${site.site.email}`} method="post" enctype="text/plain" aria-label="Newsletter signup">
        <input type="email" name="email" placeholder={g.newsletterPlaceholder} aria-label="Email address" autocomplete="email" required />
        <button type="submit">{g.newsletterButton} →</button>
      </form>
    </div>
    <div class="foot-cols">
      <div>
        <span class="brandmark"><span class="nm disp">{b.name}</span> <span class="sub">{b.subtitle.replace(/New York City/, "NYC")}</span></span>
        <p class="blurb">{g.blurb}</p>
      </div>
      {g.columns.map((col) => (
        <div>
          <h5 class="lab">{col.title}</h5>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="foot-base">
      <span>{g.legal}</span>
      <span>{g.contactLine}</span>
    </div>
  </div>
</footer>
