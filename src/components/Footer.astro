---
import { site } from "../site";
const f = site.home.footer;
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h4>{f.newsletterHeading}</h4>
        <form class="news" action={`mailto:${site.site.email}`} method="post" enctype="text/plain" aria-label={f.newsletterHeading}>
          <input name="first" placeholder="First Name (required)" aria-label="First name" autocomplete="given-name" required />
          <input name="last" placeholder="Last Name (required)" aria-label="Last name" autocomplete="family-name" required />
          <input class="full" type="email" name="email" placeholder="Email (required)" aria-label="Email address" autocomplete="email" required />
          <button class="btn sub" type="submit">{f.newsletterButton}</button>
        </form>
      </div>
      <div class="gt">
        <h5>{f.getInTouchTitle}</h5>
        <a href={`mailto:${site.site.email}`}>{site.site.email}</a>
        <p>{f.addressLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
      </div>
    </div>
    <div class="base">
      <span class="brand-line">{f.legal}</span>
      <span>{f.copyright}</span>
    </div>
  </div>
</footer>
