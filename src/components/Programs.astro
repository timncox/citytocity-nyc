---
import { site, emph } from "../site";
const p = site.home.programs;
---
<section class="programs" id="events">
  <div class="wrap pg-grid">
    <div>
      <p class="pg-ey rv" set:html={emph(p.lead)} />
      <h2 class="rv" set:html={emph(p.heading)} />
      <div class="acc rv">
        {p.items.map((item, i) => (
          <details open={i === 0}>
            <summary>{item.name} <span class="pl"></span></summary>
            <div class="abody">{item.body} <a href={item.cta.href}>{item.cta.label} →</a></div>
          </details>
        ))}
      </div>
    </div>
    <div class="pg-photo rv"><img src={p.image} alt="Leaders in a ministry gathering" loading="lazy" /></div>
  </div>
</section>
