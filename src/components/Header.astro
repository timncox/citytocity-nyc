---
import { site, emph } from "../site";
const a = site.home.announce;
const nameBase = site.site.name.replace(/\s*NYC$/, "").trim();
const hasNyc = /NYC$/.test(site.site.name);
---
<div class="announce">
  <span class="dot"></span><span set:html={emph(a.text)} />
  {a.languages?.length ? (
    <span class="lang"><b>{a.languages[0]}</b>{a.languages.slice(1).map((l) => <> &nbsp;·&nbsp; {l}</>)}</span>
  ) : null}
</div>
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/"><span class="m"></span> {nameBase}{hasNyc && <> <span class="nyc">NYC</span></>}</a>
    <nav class="menu">
      {site.nav.map((item) => (
        <a class={item.label === "Give" ? "give" : ""} href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
